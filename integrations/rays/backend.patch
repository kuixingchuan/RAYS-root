+        String actor=guard.require(req);
+        return ok(transactions.execute(tx->{int count=jdbc.sql("UPDATE rays.auth_session SET status='REVOKED',revoked_at=now(),revocation_reason='ADMIN_REVOKED' WHERE user_id=:id AND status IN ('ACTIVE','ROTATED')").param("id",id).update();audit(actor,"SESSION_REVOKE",id.toString());return Map.of("revoked",count);}));
+    }
+    @GetMapping("/audit")
+    public ResponseEntity<?> auditList(HttpServletRequest req,@RequestParam(defaultValue="100") @Min(1) @Max(500) int limit) {
