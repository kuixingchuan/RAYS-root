+    @GetMapping("/overview")
+    public ResponseEntity<?> overview(HttpServletRequest req) {
+        guard.require(req);
+        var state = new java.util.LinkedHashMap<String,Object>(jdbc.sql("""
+            SELECT (SELECT count(*) FROM rays.app_user WHERE status<>'DELETED') AS accounts,
+              (SELECT count(*) FROM rays.app_user WHERE status='DISABLED') AS disabled,
+              (SELECT count(*) FROM rays.auth_session WHERE status='ACTIVE' AND expires_at>now()) AS sessions,
+              (SELECT count(*) FROM rays.admin_audit) AS audit_events,
+              pg_database_size(current_database()) AS database_bytes, now() AS checked_at
+            """).query().singleRow());
+        state.put("api_status", "RUNNING");
+        state.put("uptime_seconds", java.lang.management.ManagementFactory.getRuntimeMXBean().getUptime()/1000);
+        state.put("heap_used_bytes", Runtime.getRuntime().totalMemory()-Runtime.getRuntime().freeMemory());
+        state.put("login_rate_limit", auth.loginRateLimit());
+        state.put("rate_limit_window_seconds", auth.rateLimitWindow().toSeconds());
+        return ok(state);
+    }
+    @PostMapping("/maintenance/expire-sessions")
+    public ResponseEntity<?> expire(HttpServletRequest req) {
+        String actor=guard.require(req);
+        return ok(transactions.execute(tx->{int count=jdbc.sql("UPDATE rays.auth_session SET status='EXPIRED' WHERE status IN ('ACTIVE','ROTATED') AND expires_at<=now()").update();audit(actor,"SESSION_EXPIRE",Integer.toString(count));return Map.of("expired",count);}));
+    }
