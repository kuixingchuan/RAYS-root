+/** 独立管理接口：业务变更与审计同一事务提交，不读取个人照片。 */
+@RestController @Validated
+@RequestMapping("/api/v1/admin")
+public class AdminController {
+    private final AdminBridgeGuard guard;
+    private final InvitedAccountService accounts;
+    private final JdbcClient jdbc;
+    private final TransactionTemplate transactions;
+    private final ApiResponses responses;
+    private final com.rays.api.auth.AuthProperties auth;
+    public AdminController(AdminBridgeGuard guard, InvitedAccountService accounts, JdbcClient jdbc,
+            TransactionTemplate transactions, ApiResponses responses, com.rays.api.auth.AuthProperties auth) {
+        this.guard=guard; this.accounts=accounts; this.jdbc=jdbc; this.transactions=transactions; this.responses=responses; this.auth=auth;
+    }
+    private void audit(String actor,String action,String target) {
+        jdbc.sql("INSERT INTO rays.admin_audit(actor,action,target) VALUES(:a,:b,:c)")
+            .param("a",actor).param("b",action).param("c",target).update();
+    }
+    private <T> ResponseEntity<ApiResponse<T>> ok(T value) {
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(responses.success(value));
+    }
+    @GetMapping("/accounts")
+    public ResponseEntity<?> list(HttpServletRequest req,@RequestParam(required=false) @Size(max=160) String q,
+            @RequestParam(required=false) InvitedAccountStatus status) {
+        guard.require(req); return ok(accounts.list(q,status));
+    }
+    @PostMapping("/accounts")
+    public ResponseEntity<?> create(HttpServletRequest req,@Valid @RequestBody CreateInvitedAccountRequest body) {
+        String actor=guard.require(req);
+        return ok(transactions.execute(tx->{var result=accounts.create(body);audit(actor,"ACCOUNT_CREATE",result.id().toString());return result;}));
+    }
+    @PatchMapping("/accounts/{id}")
+    public ResponseEntity<?> update(HttpServletRequest req,@PathVariable UUID id,@Valid @RequestBody UpdateInvitedAccountRequest body) {
+        String actor=guard.require(req);
+        return ok(transactions.execute(tx->{var result=accounts.update(id,body);audit(actor,body.disabled()?"ACCOUNT_DISABLE":"ACCOUNT_UPDATE",id.toString());return result;}));
+    }
+    @DeleteMapping("/accounts/{id}")
+    public ResponseEntity<?> delete(HttpServletRequest req,@PathVariable UUID id) {
+        String actor=guard.require(req);
+        transactions.executeWithoutResult(tx->{accounts.delete(id);audit(actor,"ACCOUNT_DELETE",id.toString());});
+        return ok(Map.of("deleted",true));
+    }
+    @PostMapping("/accounts/{id}/revoke-sessions")
