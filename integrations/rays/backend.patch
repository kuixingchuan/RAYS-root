+package com.rays.api.auth;
+
+import java.util.UUID;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.jdbc.core.simple.JdbcClient;
+import org.springframework.security.oauth2.core.*;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.stereotype.Component;
+
+/** 每次访问均检查服务端账号与会话，不缓存禁用状态。 */
+@Component
+public final class SessionAccessValidator implements OAuth2TokenValidator<Jwt> {
+    private final JdbcClient jdbc;
+    private final boolean enabled;
+    public SessionAccessValidator(JdbcClient jdbc, @Value("${rays.auth.validate-session:true}") boolean enabled) {
+        this.jdbc = jdbc; this.enabled = enabled;
+    }
+    public OAuth2TokenValidatorResult validate(Jwt jwt) {
+        if (!enabled) return OAuth2TokenValidatorResult.success();
+        try {
+            boolean active = jdbc.sql("""
+                SELECT EXISTS(SELECT 1 FROM rays.auth_session s JOIN rays.app_user u ON u.id=s.user_id
+                WHERE s.id=:sid AND u.id=:uid AND u.status='ACTIVE'
+                  AND s.status IN ('ACTIVE','ROTATED') AND s.expires_at > now())
+                """).param("sid", UUID.fromString(jwt.getClaimAsString("sid")))
+                .param("uid", UUID.fromString(jwt.getSubject())).query(Boolean.class).single();
+            if (active) return OAuth2TokenValidatorResult.success();
+        } catch (RuntimeException ignored) { /* 数据库不可用或非法声明均拒绝，不输出身份/令牌。 */ }
+        return OAuth2TokenValidatorResult.failure(new OAuth2Error("invalid_token", "Account or session is inactive", null));
+    }
+}
